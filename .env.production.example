# Production settings for deploy-compose.yml. Copy to .env on the VPS and fill in.
APP_ORIGIN=https://app.orbytlink.com
# Admin portal (app.orbytlink.com/admin): who may open it is granted on the server only, never here:
#   npm run account:production -- operator grant <email>
# 64 hex characters. Generate ONCE and keep it in a password manager:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing or losing it makes every stored credential unreadable. Backups need it too.
SECRET_KEY=
# Caddy reaches the container over the Docker network (172.16.0.0/12), not loopback.
# Safe because the published port is bound to 127.0.0.1. "loopback" here breaks sign-in (426).
TRUST_PROXY=uniquelocal
# Hosts the gateway may call. "*" allows any public HTTPS host (private ranges stay blocked);
# list exact hosts instead to restrict it.
OUTBOUND_HOSTS=*
ALLOW_SIGNUP=true
# Longest a single upstream tool call may run, in ms (default 120000).
TOOL_TIMEOUT_MS=120000
# Optional Google sign-in. Redirect URI: https://app.orbytlink.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional OIDC service clients.
OIDC_ISSUER=
OIDC_AUDIENCE=orbytlink
OIDC_JWKS_URL=

# AI models, resold. What is sold, how each model is called, what it costs and what it is sold for
# are rows in the catalog tables (server/catalog.ts), and every paid call is written to the ledger
# (usage_calls). A route row names its endpoint link and the VARIABLE holding its key; the key itself
# lives only here. Every Vercel row names AI_GATEWAY_API_KEY. With no live route, AI models are off.
#   npm run account -- catalog list | show <item> | item | route | price | decision | export | import
#   npm run account -- report [--days 30] [--by item|source|workspace|day|kind]
# Another source for a model, e.g. Groq: put GROQ_API_KEY=… below, then
#   npm run account -- catalog route <model id> groq --endpoint https://api.groq.com/openai/v1/chat/completions \
#     --key GROQ_API_KEY --ref <its model id> --in <usd per 1M in> --out <usd per 1M out>
# Add credit with: npm run account -- credits <email or workspace id> <usd>
# Prices people see come from each model's list price × the markup, whichever source answers; a
# cheaper source is margin, and a source dearer than the price is never used.
# Vercel AI Gateway (every seeded model; npm run account -- catalog sync vercel [--kind all]).
AI_GATEWAY_API_KEY=
# Google AI Studio (aistudio.google.com → API key). Then: npm run account -- catalog sync google
# GEMINI_API_KEY: a key from a project WITH billing (paid, list prices).
# GEMINI_FREE_API_KEY: optional, a key from a project WITHOUT billing. Used first (cost $0) until Google
# says its quota is spent, then calls move to the paid providers. The sync refuses it if it's billed.
GEMINI_API_KEY=
GEMINI_FREE_API_KEY=
# Sarvam Token Factory (indus.sarvam.ai/token-factory). Then:
#   npm run account -- catalog import catalog/providers/sarvam.json
SARVAM_API_KEY=
# Default markup over a route's cost, in percent (0 sells at cost). Default 5. An item's own markup
# or fixed price (catalog price …) wins over it.
AI_MARKUP_PERCENT=5
# Browser (Catalog → Scraper): runs in the scraper's Chromium; each step a DECISION model picks the
# operation and the element (catalog decision …; default Jev, Perplexity Decider Flash, Liquid d1).
# A step is sold at the price of item orbytlink/browser-step ($0.001 unless set with catalog price).
# BROWSER_BLOCK_HOSTS=

# Online top-ups with Cashfree (leave the keys empty to switch payments off).
# Use the sandbox App ID and Secret first; set CASHFREE_ENV=production only for live keys.
# In Cashfree's dashboard, add https://<your-domain>/api/payments/webhook as the payment webhook.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree's cut, added to each price so the whole credit is paid for (check your account's rate).
PAYMENT_FEE_PERCENT=3
PAYMENT_FEE_FIXED_USD=0
# Rupees per dollar for the ₹ prices, and GST added to them (0 until you are registered).
USD_INR_RATE=90
GST_PERCENT_INR=0

# Dollar top-ups with Dodo Payments (merchant of record; it adds and remits sales tax).
# With these set, USD orders go to Dodo and INR orders stay on Cashfree. Leave empty to keep USD on Cashfree.
# Create a one-time, pay-what-you-want USD product (tax category SaaS) and put its id in DODO_PRODUCT_ID.
# In Dodo's dashboard, add https://<your-domain>/api/payments/dodo/webhook as a webhook endpoint
# (events: payment.succeeded, payment.failed) and paste its signing secret below.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# Dodo's cut on international cards, added to each dollar price (check your account's rate).
DODO_FEE_PERCENT=5.5
DODO_FEE_FIXED_USD=0.40

# Invite emails via Resend (optional). Without both, invites are links to copy.
# The MAIL_FROM domain must be verified at resend.com/domains. A send-only key is enough.
RESEND_API_KEY=
MAIL_FROM=OrbytLink <invites@orbytlink.com>

# Scraper (comes with OrbytLink). Plain page reads always work; the stealth browser (scraper
# service in deploy-compose.yml) handles pages that block plain requests and Google Maps.
SCRAPER_URL=http://scraper:8700
SCRAPER_TOKEN=
# Daily allowance per workspace (defaults shown).
# SCRAPER_DAILY_PAGES=3000
# Browser sessions open at once (each is one private Chromium context).
# SCRAPER_SESSIONS=3
# ── Instant tools (Catalog → Instant) ────────────────────────────────────────
# Wholesale sources, never named to workspaces. A source is used only when its key is set.
# Each call goes to the cheapest source with money for it. A tool's price is its cheapest source
# cost × (1 + markup/100), worked out live: change this and restart, nothing else to redo. A price
# set by hand (npm run account -- instant price / prices-import) wins over it.
INSTANT_MARKUP_PERCENT=20
# a: treg.to — a TEAM token (not a login token). Terms allow embedding in a product.
INSTANT_A_TOKEN=
# b: monid.ai (monid_live_…). Legal terms need written approval for commercial use: ask first.
INSTANT_B_TOKEN=
# c: orthogonal.com (orth_live_…). Terms forbid resale without written authorization: ask first.
INSTANT_C_TOKEN=
# d: o11.ai (o11_…), optional card id. Terms need approval for commercial use: ask first.
INSTANT_D_TOKEN=
INSTANT_D_CARD=
# e: composio.dev, Instant Toolkits on. Terms forbid resale: temporary, remove for full rollout.
# It has no balance API: record its balance with `npm run account -- instant wallet e <usd>`.
INSTANT_E_TOKEN=
# SCRAPER_DAILY_STEALTH=300
# SCRAPER_DAILY_MAPS=30

# Social accounts (Catalog → Social). Register one app per platform, add this redirect URI to each:
#   https://<APP_ORIGIN host>/api/oauth/callback
# People then click Connect and approve on the platform's own page. Leave a pair empty to hide it.
# LinkedIn (developer.linkedin.com): products "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn"; company pages also need "Community Management API" (LinkedIn approval).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=        # YYYYMM; defaults to two months back
# Facebook Pages (developers.facebook.com): a Business app with Facebook Login for Business.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Instagram signs in through Facebook Login with the Facebook app's keys above (no keys of its own
# needed): the Instagram professional account must be linked to a Facebook Page you manage. Add the
# Instagram use case "API setup with Facebook login" to the same Meta app. Set these only to use a
# different Meta app for Instagram.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Threads (same Meta app, Threads use case): its Threads app ID/secret.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# YouTube (console.cloud.google.com): YouTube Data API v3 on, a Web OAuth client.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok (developers.tiktok.com): Login Kit + Content Posting API. ID = the client key.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Reddit (reddit.com/prefs/apps): a "web app".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# SOCIAL_USER_AGENT=web:yourapp:1.0   # Reddit requires a descriptive User-Agent
# Pinterest (developers.pinterest.com): an app with boards/pins scopes.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# X (developer.x.com): OAuth 2.0 on, type "Web App" (confidential client).
X_CLIENT_ID=
X_CLIENT_SECRET=
