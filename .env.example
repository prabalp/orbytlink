# Local development. npm run dev loads .env automatically.
PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3100
DATA_DIR=.data
# Production requires HTTPS APP_ORIGIN and a stable 32-byte encryption key.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
# Users register with email + password; each account owns an isolated workspace.
# Set false to restrict account creation to the operator CLI.
ALLOW_SIGNUP=true
# Leave empty when connecting directly. Behind a local HTTPS reverse proxy, use loopback.
# Never blindly trust arbitrary X-Forwarded-* headers on a public listener.
TRUST_PROXY=
# HTTPS hosts the gateway may connect to, comma-separated. Use exact hosts,
# "*.example.com" for subdomains, or "*" for any public host. Private, loopback,
# link-local and reserved addresses are always blocked. Empty blocks everything.
# OAuth sign-in contacts each provider's token server too, so allow those hosts as well,
# e.g. mcp.notion.com,*.googleapis.com,accounts.google.com,slack.com,*.slack.com
# APP_ORIGIN (below) is also the base of the OAuth redirect URI: <APP_ORIGIN>/api/oauth/callback
OUTBOUND_HOSTS=
# Optional enterprise/service-client OIDC authentication, not required for email login.
OIDC_ISSUER=
OIDC_AUDIENCE=orbytlink
OIDC_JWKS_URL=
# Email is a login identifier. SMTP, email verification, sandbox and payments are not configured.

# Optional Google sign-in (OAuth web client from Google Cloud Console). Register this
# authorized redirect URI on the client: <APP_ORIGIN>/api/auth/google/callback
# e.g. http://127.0.0.1:3100/api/auth/google/callback locally,
#      https://app.orbytlink.com/api/auth/google/callback in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI models, resold: OrbytLink calls the Vercel AI Gateway with this key and charges each
# workspace the catalog price from its AI credit. Leave empty to keep AI models off.
# Add credit with: npm run account -- credits <email or workspace id> <usd>
AI_GATEWAY_API_KEY=
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
# Markup on AI model prices, in percent over the provider's list price: 0 sells at cost, 10 adds 10%.
# Unset keeps the 5% the catalog was built with. Prices shown and charged both follow it.
AI_MARKUP_PERCENT=5

# Online top-ups with Cashfree (leave the keys empty to switch payments off).
# Use the sandbox App ID and Secret first; set CASHFREE_ENV=production only for live keys.
# In Cashfree's dashboard, add https://<your-domain>/api/payments/webhook as the payment webhook.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree's cut, added to each price so the whole credit is paid for (check your account's rate).
PAYMENT_FEE_PERCENT=3
PAYMENT_FEE_FIXED_USD=0
# Rupees per dollar for the ₹ prices, and GST added to them (0 until you are registered).
USD_INR_RATE=90
GST_PERCENT_INR=0

# Dollar top-ups with Dodo Payments (merchant of record; it adds and remits sales tax).
# With these set, USD orders go to Dodo and INR orders stay on Cashfree. Leave empty to keep USD on Cashfree.
# Create a one-time, pay-what-you-want USD product (tax category SaaS) and put its id in DODO_PRODUCT_ID.
# In Dodo's dashboard, add https://<your-domain>/api/payments/dodo/webhook as a webhook endpoint
# (events: payment.succeeded, payment.failed) and paste its signing secret below.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# Dodo's cut on international cards, added to each dollar price (check your account's rate).
DODO_FEE_PERCENT=5.5
DODO_FEE_FIXED_USD=0.40
