{
  "name": "orbytlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node --env-file-if-exists=.env build/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "account": "node --env-file-if-exists=.env --import tsx server/account.ts",
    "account:production": "NODE_ENV=production node --env-file-if-exists=.env build/server/account.js"
  },
  "dependencies": {
