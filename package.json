    "@types/whatwg-mimetype": "https://registry.npmjs.org/@types/whatwg-mimetype/-/whatwg-mimetype-3.0.2.tgz",
    "@types/ws": "https://registry.npmjs.org/@types/ws/-/ws-8.18.1.tgz",
    "@vitejs/plugin-react": "https://registry.npmjs.org/@vitejs/plugin-react/-/plugin-react-6.0.2.tgz",
    "eslint": "9.39.1",
