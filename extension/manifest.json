{
  "manifest_version": 3,
  "name": "OrbytLink: Your browser",
  "version": "0.1.0",
  "description": "Lets your OrbytLink agents work in this Chrome profile, with the sites you are already signed in to. You approve every site.",
  "icons": { "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "OrbytLink", "default_popup": "panel.html", "default_icon": { "48": "icon-48.png" } },
  "options_ui": { "page": "panel.html?options=1", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "minimum_chrome_version": "116"
}
